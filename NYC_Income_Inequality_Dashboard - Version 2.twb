            <column caption='B03002 006E' datatype='integer' name='[B03002_006E]' role='measure' type='quantitative' />
            <column caption='B03002 012E' datatype='integer' name='[B03002_012E]' role='measure' type='quantitative' />
            <column caption='B17001 001E' datatype='integer' name='[B17001_001E]' role='measure' type='quantitative' />
            <column caption='B17001 002E' datatype='integer' name='[B17001_002E]' role='measure' type='quantitative' />
            <column caption='B19001 001E' datatype='integer' name='[B19001_001E]' role='measure' type='quantitative' />
            <column caption='B19013 001E' datatype='integer' name='[B19013_001E]' role='measure' type='quantitative' />
            <column caption='Filter for Populated Neigbrhoods' datatype='string' name='[Calculation_480196368054988807]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [B19001_001E] &gt; 0 &#13;&#10;   AND NOT ISNULL([B19013_001E]) &#13;&#10;   AND [B19013_001E] &gt; 0&#13;&#10;THEN &quot;Valid&quot;&#13;&#10;ELSE &quot;Exclude&quot;&#13;&#10;END' />
            </column>
            <column caption='% of Population Iiving Below The Povery Line' datatype='real' default-format='p0%' name='[Calculation_897623758525497344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([B17001_002E]) / SUM([B17001_001E])' />
            </column>
            <column caption='% of Population Iiving Over The Povery Line' datatype='real' default-format='p0%' name='[Calculation_897623758525804545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([B17001_001E]) - SUM([B17001_002E])) / SUM([B17001_001E])' />
            </column>
            <column caption='Neigborhood Racial Majority Group' datatype='string' name='[Calculation_897623758544334855]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [NTAName] :&#13;&#10;    IF SUM([B03002_003E]) / SUM([B03002_001E]) &gt;= 0.5 THEN &quot;Majority White&quot;&#13;&#10;    ELSEIF SUM([B03002_004E]) / SUM([B03002_001E]) &gt;= 0.5 THEN &quot;Majority Black&quot;&#13;&#10;    ELSEIF SUM([B03002_006E]) / SUM([B03002_001E]) &gt;= 0.5 THEN &quot;Majority Asian&quot;&#13;&#10;    ELSEIF SUM([B03002_012E]) / SUM([B03002_001E]) &gt;= 0.5 THEN &quot;Majority Hispanic&quot;&#13;&#10;&#13;&#10;    ELSEIF SUM([B03002_003E]) / SUM([B03002_001E]) &gt;= 0.4&#13;&#10;       AND SUM([B03002_003E]) / SUM([B03002_001E]) &gt;= SUM([B03002_004E]) / SUM([B03002_001E])&#13;&#10;       AND SUM([B03002_003E]) / SUM([B03002_001E]) &gt;= SUM([B03002_006E]) / SUM([B03002_001E])&#13;&#10;       AND SUM([B03002_003E]) / SUM([B03002_001E]) &gt;= SUM([B03002_012E]) / SUM([B03002_001E])&#13;&#10;    THEN &quot;Plurality White&quot;&#13;&#10;&#13;&#10;    ELSEIF SUM([B03002_004E]) / SUM([B03002_001E]) &gt;= 0.4&#13;&#10;       AND SUM([B03002_004E]) / SUM([B03002_001E]) &gt;= SUM([B03002_003E]) / SUM([B03002_001E])&#13;&#10;       AND SUM([B03002_004E]) / SUM([B03002_001E]) &gt;= SUM([B03002_006E]) / SUM([B03002_001E])&#13;&#10;       AND SUM([B03002_004E]) / SUM([B03002_001E]) &gt;= SUM([B03002_012E]) / SUM([B03002_001E])&#13;&#10;    THEN &quot;Plurality Black&quot;&#13;&#10;&#13;&#10;    ELSEIF SUM([B03002_006E]) / SUM([B03002_001E]) &gt;= 0.4&#13;&#10;       AND SUM([B03002_006E]) / SUM([B03002_001E]) &gt;= SUM([B03002_003E]) / SUM([B03002_001E])&#13;&#10;       AND SUM([B03002_006E]) / SUM([B03002_001E]) &gt;= SUM([B03002_004E]) / SUM([B03002_001E])&#13;&#10;       AND SUM([B03002_006E]) / SUM([B03002_001E]) &gt;= SUM([B03002_012E]) / SUM([B03002_001E])&#13;&#10;    THEN &quot;Plurality Asian&quot;&#13;&#10;&#13;&#10;    ELSEIF SUM([B03002_012E]) / SUM([B03002_001E]) &gt;= 0.4&#13;&#10;       AND SUM([B03002_012E]) / SUM([B03002_001E]) &gt;= SUM([B03002_003E]) / SUM([B03002_001E])&#13;&#10;       AND SUM([B03002_012E]) / SUM([B03002_001E]) &gt;= SUM([B03002_004E]) / SUM([B03002_001E])&#13;&#10;       AND SUM([B03002_012E]) / SUM([B03002_001E]) &gt;= SUM([B03002_006E]) / SUM([B03002_001E])&#13;&#10;    THEN &quot;Plurality Hispanic&quot;&#13;&#10;&#13;&#10;    ELSE &quot;Mixed&quot;&#13;&#10;    END&#13;&#10;}' />
            </column>
            <column caption='Neighborhood Name' datatype='string' name='[NTAName]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_480196368054988807]' derivation='None' name='[none:Calculation_480196368054988807:nk]' pivot='key' type='nominal' />
