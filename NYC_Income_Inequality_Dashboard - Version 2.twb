          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='12'>Which Boroughs Drive NYC&apos;s Income Disparity?</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10'>Median Household Income varies from $54K to $118K in NYC Boroughs</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='nynta2020.shp+ (Multiple Connections)' name='federated.0fqqhae0jzv21w145ovdf1shrfhm' />
