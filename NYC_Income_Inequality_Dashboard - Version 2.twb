      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Book' fontsize='12'>How Does Employment Status Dictate Economic Opportunity in NYC?</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Book' fontsize='10'>Employment Disparity: The Bronx Faces the Highest Rates of Unemployment (7%) and Non-Participation (41%)..</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
