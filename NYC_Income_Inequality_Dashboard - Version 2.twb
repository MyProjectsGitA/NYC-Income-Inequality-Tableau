            <column caption='B15003 016E' datatype='integer' name='[B15003_016E]' role='measure' type='quantitative' />
            <column caption='B15003 017E' datatype='integer' name='[B15003_017E]' role='measure' type='quantitative' />
            <column caption='B15003 018E' datatype='integer' name='[B15003_018E]' role='measure' type='quantitative' />
            <column caption='B15003 021E' datatype='integer' name='[B15003_021E]' role='measure' type='quantitative' />
            <column caption='B15003 022E' datatype='integer' name='[B15003_022E]' role='measure' type='quantitative' />
            <column caption='B15003 023E' datatype='integer' name='[B15003_023E]' role='measure' type='quantitative' />
            <column caption='B15003 024E' datatype='integer' name='[B15003_024E]' role='measure' type='quantitative' />
            <column caption='B15003 025E' datatype='integer' name='[B15003_025E]' role='measure' type='quantitative' />
            <column caption='B19001 001E' datatype='integer' name='[B19001_001E]' role='measure' type='quantitative' />
            <column caption='B19013 001E' datatype='integer' name='[B19013_001E]' role='measure' type='quantitative' />
            <column caption='Neighborhood Group by Median Household Income' datatype='string' name='[Calculation_1436929814182785031]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Neighborhood Income Category (Absolute, at NTA level)&#13;&#10;IF { FIXED [NTAName] :&#13;&#10;        SUM(IIF([B19013_001E] &gt; 0, [B19013_001E] * [B19001_001E], 0)) &#13;&#10;        /&#13;&#10;        SUM(IIF([B19013_001E] &gt; 0, [B19001_001E], 0))&#13;&#10;   } &lt; 40000&#13;&#10;THEN &quot;Below 40,000$&quot;&#13;&#10;&#13;&#10;ELSEIF { FIXED [NTAName] :&#13;&#10;        SUM(IIF([B19013_001E] &gt; 0, [B19013_001E] * [B19001_001E], 0)) &#13;&#10;        /&#13;&#10;        SUM(IIF([B19013_001E] &gt; 0, [B19001_001E], 0))&#13;&#10;   } &lt; 80000&#13;&#10;THEN &quot;Between 40,000$-80,000$&quot;&#13;&#10;&#13;&#10;ELSEIF { FIXED [NTAName] :&#13;&#10;        SUM(IIF([B19013_001E] &gt; 0, [B19013_001E] * [B19001_001E], 0)) &#13;&#10;        /&#13;&#10;        SUM(IIF([B19013_001E] &gt; 0, [B19001_001E], 0))&#13;&#10;   } &lt; 120000&#13;&#10;THEN &quot;Between 80,000$-120,000$&quot;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;ELSE &quot;Over 120,000$&quot;&#13;&#10;END' />
            </column>
            <column caption='&gt; High School' datatype='real' default-format='p0%' name='[Calculation_1436929814225162255]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    ([B15003_001E] - &#13;&#10;     ([B15003_016E] + [B15003_017E] + [B15003_018E] +&#13;&#10;      [B15003_021E] + [B15003_022E] + [B15003_023E] + [B15003_024E] + [B15003_025E]))&#13;&#10;) &#13;&#10;/ SUM([B15003_001E])' />
            </column>
            <column caption='High School ' datatype='real' default-format='p0%' name='[Calculation_1436929814225375248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([B15003_016E]) / SUM([B15003_001E])' />
            </column>
            <column caption='Some College' datatype='real' default-format='p0%' name='[Calculation_1436929814225559569]' role='measure' type='quantitative'>
