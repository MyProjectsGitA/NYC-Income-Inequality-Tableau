    <worksheet name='Sheet 17 (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Book' fontsize='12'>Does Education Pave the Path to Prosperity in NYC?</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Book' fontsize='10'>Education is a Strong Predictor of Income: 75% of High-Income Residents Hold Advanced Degrees.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='nynta2020.shp+ (Multiple Connections)' name='federated.0fqqhae0jzv21w145ovdf1shrfhm' />
          </datasources>
          <datasource-dependencies datasource='federated.0fqqhae0jzv21w145ovdf1shrfhm'>
