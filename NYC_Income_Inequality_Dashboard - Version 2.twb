  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Dashboard '>
      <style />
      <size maxheight='8350' maxwidth='1200' minheight='8350' minwidth='1200' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Level Selector Parameter' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Neighborhood Income Group Level&quot;'>
          <calculation class='tableau' formula='&quot;Neighborhood Income Group Level&quot;' />
          <members>
            <member value='&quot;Borough Level&quot;' />
            <member value='&quot;Neighborhood Income Group Level&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <zones>
        <zone h='1198' id='9' param='horz' type-v2='layout-flow' w='98333' x='750' y='120'>
          <zone h='1198' id='75' type-v2='text' w='98333' x='750' y='120'>
            <formatted-text>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='20'>Income Inequality in New York City</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>Exploring </run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Geographic Patterns, Racial Disparities, Household Composition, and Structural Drivers</run>
              <run fontcolor='#000000' fontsize='12'> across all five boroughs.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='2156' id='10' param='horz' type-v2='layout-flow' w='98333' x='750' y='1437'>
          <zone forceUpdate='true' h='2156' id='76' type-v2='text' w='98333' x='750' y='1437'>
            <formatted-text>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>As New Yorkers, it&apos;s important to see a clear picture of the economic life across the five boroughs. Using 2023 American Community Survey (ACS) 5-Year Estimates at the Census Tract level, this analysis explores the contrasts that shape income inequality in New York City. It highlights key patterns in income, poverty, and demographics (Sections 1–3) and examines deeper structural factors such as education, gender pay gaps, unemployment, and disability (Section 4). Together, these insights reveal the full spectrum of economic realities across the city—from areas of affluence to those facing greater financial strain—and the factors that shape these differences. The guiding question: &quot;Where and why is economic disparity most pronounced in NYC, and how do these contrasts define the city’s economic landscape?&quot;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='1437' id='12' param='horz' type-v2='layout-flow' w='98333' x='750' y='4311'>
          <zone h='1437' id='77' type-v2='text' w='98333' x='750' y='4311'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='20'>Section 1: Spatial Analysis of Income Inequality</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>This analysis highlights stark geographic contrasts by examining Median Household Income, Rent Burden, and Poverty Levels across all five boroughs and their neighborhoods. </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='479' id='13' param='horz' type-v2='layout-flow' w='98333' x='750' y='5868'>
          <zone h='479' id='78' type-v2='text' w='98333' x='750' y='5868'>
            <formatted-text>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='15'>Borough-Level Economic Contrast</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4192' id='14' param='horz' type-v2='layout-flow' w='48750' x='750' y='6467'>
          <zone h='4192' id='79' name='Sheet 4' w='48750' x='750' y='6467'>
            <layout-cache minwidth='100' type-h='fixed' type-w='scalable' />
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4192' id='15' param='horz' type-v2='layout-flow' w='48750' x='50000' y='6467'>
          <zone h='4192' id='80' name='Sheet 5' w='48750' x='50000' y='6467'>
            <layout-cache minwidth='100' type-h='fixed' type-w='scalable' />
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4192' id='16' param='horz' type-v2='layout-flow' w='48750' x='750' y='10778'>
          <zone h='4192' id='81' name='Sheet 6' w='48750' x='750' y='10778'>
            <layout-cache minwidth='200' type-h='fixed' type-w='scalable' />
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4192' id='17' param='horz' type-v2='layout-flow' w='48750' x='50000' y='10778'>
          <zone forceUpdate='true' h='4192' id='82' type-v2='text' w='48750' x='50000' y='10778'>
            <formatted-text>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>The borough-level analysis clearly establishes the spectrum of economic stress in NYC:</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'> * Income Polarization:</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'> Median Household Income shows a near two-fold gap, with Manhattan ($118K) and Staten Island ($102K) anchoring the high end, contrasting sharply with The Bronx ($54K).</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'> * Concentrated Financial Strain:</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'> The Bronx is the most vulnerable borough, facing the lowest income and highest poverty rate (27%), severely amplified by the highest rate of rent burden (57%).</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'> * Internal Disparity:</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'> Despite high overall wealth, Manhattan (16%) and Brooklyn (19%) contain significant internal poverty, underscoring that income inequality exists even within the city&apos;s most affluent boroughs.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'> * Uneven Housing Challenge:</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>  Housing cost pressure is a near-universal challenge, but its financial impact is most amplified in low-income areas</run>
              <run fontcolor='#000000' fontname='Benton Sans Book'>.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='479' id='18' param='horz' type-v2='layout-flow' w='98333' x='750' y='15090'>
          <zone h='479' id='83' type-v2='text' w='98333' x='750' y='15090'>
            <formatted-text>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='15'>Neighborhood-Level Income Boundaries</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='5389' id='19' param='horz' type-v2='layout-flow' w='87500' x='750' y='15689'>
          <zone h='5389' id='84' name='Sheet 1' w='87500' x='750' y='15689'>
            <layout-cache minwidth='202' type-h='fixed' type-w='scalable' />
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='1677' id='20' param='horz' type-v2='layout-flow' w='98333' x='750' y='21198'>
          <zone h='1677' id='88' type-v2='text' w='98333' x='750' y='21198'>
            <formatted-text>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>The sharpest income divides appear in Manhattan and western Brooklyn. In Manhattan, high incomes stretch from the Financial District through Midtown to the Upper East and West Sides, dropping sharply nearby in East Harlem and the Lower East Side. Western Brooklyn—from Brooklyn Heights through Park Slope and gentrified areas in Williamsburg—shows similar wealth, while incomes fall in central and eastern areas like Bedford-Stuyvesant and East New York. Queens is more mixed, with higher incomes in the east. The Bronx remains lowest overall, and Staten Island, is mostly made up of higher income sub-urban neighborhoods. </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='479' id='21' param='horz' type-v2='layout-flow' w='98333' x='750' y='22994'>
          <zone h='479' id='89' type-v2='text' w='98333' x='750' y='22994'>
            <formatted-text>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='15'>Neighborhood Trends: Exploring Income&apos;s Correlation</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4192' id='22' param='horz' type-v2='layout-flow' w='65000' x='750' y='23593'>
          <zone h='4192' id='90' name='Sheet 2' w='65000' x='750' y='23593'>
            <layout-cache cell-count-w='200' minheight='144' non-cell-size-w='69' type-h='scalable' type-w='cell' />
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4192' id='23' param='horz' type-v2='layout-flow' w='32500' x='66667' y='23593'>
          <zone forceUpdate='true' h='4192' id='93' type-v2='text' w='32500' x='66667' y='23593'>
            <formatted-text>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>Median household income across NYC neighborhoods spans a broad range—from $29K to $222K—capturing the full spectrum of income levels. Most neighborhoods (156) cluster in the moderate-income range of $40K to $120K, while fewer neighborhoods fall in the low-income bracket (12 below $40K) or the high-income bracket (32 above $120K), highlighting a concentration of economic activity in the middle tiers.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4192' id='24' param='horz' type-v2='layout-flow' w='65000' x='750' y='27904'>
          <zone h='4192' id='91' name='Sheet 2 (3)' w='65000' x='750' y='27904'>
            <layout-cache cell-count-w='200' minheight='144' non-cell-size-w='53' type-h='scalable' type-w='cell' />
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4192' id='25' param='horz' type-v2='layout-flow' w='32500' x='66667' y='27904'>
          <zone h='4192' id='94' type-v2='text' w='32500' x='66667' y='27904'>
            <formatted-text>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>As neighborhood income rises, rent burden generally declines—while low-income areas see rates as high as 65%, high-income neighborhoods typically fall closer to 30–45%, with some exceptions. This scatter plot clearly shows a strong inverse relationship. This suggests that higher neighborhood earnings generally outpace rising rental costs</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4192' id='28' param='horz' type-v2='layout-flow' w='65000' x='750' y='32216'>
          <zone h='4192' id='92' name='Sheet 2 (4)' w='65000' x='750' y='32216'>
            <layout-cache cell-count-w='200' minheight='144' non-cell-size-w='61' type-h='scalable' type-w='cell' />
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4192' id='29' param='horz' type-v2='layout-flow' w='32500' x='66667' y='32216'>
          <zone h='4192' id='95' type-v2='text' w='32500' x='66667' y='32216'>
            <formatted-text>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>The sharp inverse relationship between the median household income and poverty level in NYC neighborhoods underscores how deeply income inequality shapes the distribution of poverty across New York City—lower-income neighborhoods are affected disproportionately.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='1437' id='32' param='horz' type-v2='layout-flow' w='98333' x='750' y='39042'>
          <zone h='1437' id='99' type-v2='text' w='98333' x='750' y='39042'>
            <formatted-text>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='20'>The Racial Income Divide </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>Examining how neighborhood racial concentration creates distinct patterns of economic disparity in income, poverty, and housing cost pressures. </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='719' id='33' param='horz' type-v2='layout-flow' w='98333' x='750' y='40599'>
          <zone h='719' id='100' type-v2='text' w='98333' x='750' y='40599'>
            <formatted-text>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>In this section, neighborhoods are classified based on their single most prevalent racial or ethnic group, defined as either a Majority (&gt;50% of the neighborhood population) or a Plurality (40–50% of the neighborhood population)</run>
              <run fontcolor='#000000' fontname='Benton Sans Book'>. </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='479' id='34' param='horz' type-v2='layout-flow' w='98333' x='750' y='41437'>
          <zone h='479' id='101' type-v2='text' w='98333' x='750' y='41437'>
            <formatted-text>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='15'>Racial Segregation and Concentration by Borough </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4192' id='35' param='horz' type-v2='layout-flow' w='58333' x='750' y='42036'>
          <zone h='4192' id='102' name='Sheet 7' w='58333' x='750' y='42036'>
            <layout-cache minwidth='304' type-h='fixed' type-w='scalable' />
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4192' id='36' param='horz' type-v2='layout-flow' w='39583' x='59583' y='42036'>
          <zone h='4192' id='103' type-v2='text' w='39583' x='59583' y='42036'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'>Although NYC is known for its racial diversity, only 28 neighborhoods are classified as racially mixed.</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'> This makes the mixed group the fourth-largest, significantly trailing neighborhoods with a Majority White (56), Majority Hispanic (36), and Majority Black (31) population. This pattern suggests that </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'>diversity at the city level often masks racial separation at the neighborhood level.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4551' id='41' param='horz' type-v2='layout-flow' w='91667' x='750' y='46347'>
          <zone h='4551' id='104' name='Sheet 7 (2)' w='91667' x='750' y='46347'>
            <layout-cache cell-count-w='35' minheight='304' non-cell-size-w='1' type-h='scalable' type-w='cell' />
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='958' id='42' param='horz' type-v2='layout-flow' w='98333' x='750' y='51018'>
          <zone h='958' id='105' type-v2='text' w='98333' x='750' y='51018'>
            <formatted-text>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>In the Bronx, majority Hispanic neighborhoods dominate, outweighing all other groups. In Brooklyn, majority Black and majority White neighborhoods make up the largest shares. Staten Island is predominantly majority White, while Queens features mostly mixed neighborhoods alongside substantial representation from other groups.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='479' id='43' param='horz' type-v2='layout-flow' w='98333' x='750' y='52096'>
          <zone h='479' id='106' type-v2='text' w='98333' x='750' y='52096'>
            <formatted-text>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='15'>Economic Outcomes: The Financial Impact of Racial Concentration </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4192' id='44' param='horz' type-v2='layout-flow' w='48750' x='750' y='52695'>
          <zone h='4192' id='108' name='Sheet 8' w='48750' x='750' y='52695'>
            <layout-cache cell-count-w='9' minheight='222' type-h='scalable' type-w='cell' />
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4192' id='45' param='horz' type-v2='layout-flow' w='48750' x='50000' y='52695'>
          <zone h='4192' id='109' name='Sheet 9' w='48750' x='50000' y='52695'>
            <layout-cache minwidth='102' type-h='fixed' type-w='scalable' />
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4192' id='48' param='horz' type-v2='layout-flow' w='48750' x='750' y='57006'>
          <zone h='4192' id='110' name='Sheet 11' w='48750' x='750' y='57006'>
            <layout-cache minwidth='292' type-h='fixed' type-w='scalable' />
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4192' id='49' param='horz' type-v2='layout-flow' w='48750' x='50000' y='57006'>
          <zone h='4192' id='107' type-v2='text' w='48750' x='50000' y='57006'>
            <formatted-text>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>The analysis reveals that economic status is highly stratified by neighborhood racial concentration:</run>
              <run>Æ&#10;</run>
              <run fontname='Tableau Light' fontsize='10'>Æ </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'> * Extreme Income Contrast:</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'> Neighborhoods with a </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'>Majority White</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'> population earn approximately </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'>double</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'> the median income ($124K) of those with a </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'>Majority Hispanic</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'> population ($55K).</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'> * Poverty&apos;s Reflection:</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'> Poverty rates are nearly an inverse reflection of this income hierarchy, with low-income groups (Majority Hispanic, Majority Asian) facing the highest poverty rates (26% and 21%).</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'> * Housing Pressure Disparity:</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'> While all groups face significant rent burden (ranging 43% to 56%), the pressure is most severe for low-income groups, with </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'>Majority Hispanic</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'> neighborhoods experiencing the highest rate (56%).</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'> * Structural Implication:</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'> This data confirms that </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'>racial concentration is one of the most powerful predictors of economic vulnerability</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'> in NYC.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='1796' id='52' param='horz' type-v2='layout-flow' w='98333' x='750' y='61317'>
          <zone h='1796' id='113' type-v2='text' w='98333' x='750' y='61317'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='15'>Conclusion: The Racial Income Divide</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>The analysis confirms that </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'>economic status in NYC is fundamentally stratified by racial concentration</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>, where neighborhood demographics are a powerful predictor of financial outcome. This structure results in a </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'>severe income gap</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'> (White majority neighborhoods earning nearly double Hispanic majority neighborhoods) that is mirrored by disproportionately high poverty rates and the highest rates of financial stress from rent burden among low-income minority groups.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4192' id='54' param='horz' type-v2='layout-flow' w='66667' x='750' y='64910'>
          <zone h='4192' id='118' name='Sheet 16' w='66667' x='750' y='64910'>
            <layout-cache type-h='fixed' type-w='scalable' />
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4192' id='55' param='horz' type-v2='layout-flow' w='31250' x='67917' y='64910'>
          <zone forceUpdate='true' h='4192' id='119' type-v2='text' w='31250' x='67917' y='64910'>
            <formatted-text>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>Manhattan and Staten Island have the highest median household incomes, but their household structures differ sharply. On Staten Island, 73% of households are families, compared with just 41% in Manhattan—reflecting a clear suburban–urban contrast. The other three boroughs fall within a narrower range of 59–67%. </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4192' id='56' param='horz' type-v2='layout-flow' w='50000' x='750' y='69222'>
          <zone h='4192' id='121' name='Sheet 15' w='50000' x='750' y='69222'>
            <layout-cache minwidth='260' type-h='fixed' type-w='scalable' />
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4192' id='57' param='horz' type-v2='layout-flow' w='47917' x='51250' y='69222'>
          <zone h='4192' id='120' type-v2='text' w='47917' x='51250' y='69222'>
            <formatted-text>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'>Family household concentration is consistent across low- and moderate-income areas, but drops sharply in the highest bracket.</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'> While neighborhoods earning $40,000–$120,000 show family household rates around </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'>60–62%</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>, this share drops significantly to </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'>44%</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'> in areas above $120,000. This stark contrast highlights a higher presence of non-family and diverse household types in the city&apos;s most affluent areas.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='2036' id='58' param='horz' type-v2='layout-flow' w='98333' x='750' y='73533'>
          <zone h='2036' id='122' type-v2='text' w='98333' x='750' y='73533'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='15'>Conclusion: Household Composition and Income</run>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='15'>Æ </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>The analysis reveals that the relationship between concentration of family households and neighborhood wealth household income. The contrast between </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'>Staten Island (high income, high family share—reflecting a suburban context)</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'> and </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'>Manhattan (high income, low family share—reflecting an urban context)</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'> is clear. The pattern across the cities neighborhoods is defined by the </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'>Affluent Anomaly</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>: the share of family households drops significantly to </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'>44%</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'> in the </run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'>Over $120,000</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'> household income bracket, highlighting that high-income areas are defined by diverse, non-family household structures. </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='1317' id='60' param='horz' type-v2='layout-flow' w='98333' x='750' y='76048'>
          <zone forceUpdate='true' h='1317' id='123' type-v2='text' w='98333' x='750' y='76048'>
            <formatted-text>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='20'>Setion 4: Structural Drivers of Inequality (Adjustable View Level)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>This section analyzes the correlation between neighborhood income levels and four key socioeconomic factors: Educational Attainment, the Gender Pay Gap, Employment Status, and Disability. </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='4192' id='62' param='horz' type-v2='layout-flow' w='98333' x='750' y='78323'>
