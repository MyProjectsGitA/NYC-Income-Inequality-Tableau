        <calculation class='tableau' formula='IF ISNULL([Calculation_480196368053501957]) OR [Calculation_480196368053501957] &lt;= 0 THEN&#13;&#10;    &quot;Not Applicable (Non Populated Area)&quot;&#13;&#10;ELSE&#13;&#10;STR(ROUND([Calculation_480196368054554630] * 100, 0)) + &quot;%&quot;&#13;&#10;END' />
      </column>
      <column caption='Povery level Tooltip' datatype='string' name='[Calculation_1371064671698857987]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_480196368053501957]) OR [Calculation_480196368053501957] &lt;= 0 THEN&#13;&#10;    &quot;Not Applicable (Non Populated Area)&quot;&#13;&#10;ELSE&#13;&#10;    STR(ROUND([Calculation_897623758525497344] * 100, 0)) + &quot;%&quot;&#13;&#10;END' />
      </column>
      <column caption='c. View Selector' datatype='string' name='[Calculation_1371064672049668100]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='Borough Level Selevtor Calculated Field' datatype='boolean' name='[Calculation_1371064672069824517]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2] = &apos;Borough Level&apos; THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Neighborhood Income Group Level Selector Calculated Field ' datatype='boolean' name='[Calculation_1371064672070385670]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2] = &apos;Neighborhood Income Group Level&apos; THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Number of Hiuseholds (Neighborhood))' datatype='real' name='[Calculation_1371064672413339656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [NTAName] : SUM([Number of Households])}' />
      </column>
      <column caption='Neighborhood Group by Median Household Income' datatype='string' name='[Calculation_1436929814182785031]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Neighborhood Income Category (Absolute, at NTA level)&#13;&#10;IF { FIXED [NTAName] :&#13;&#10;        SUM(IIF([B19013_001E] &gt; 0, [B19013_001E] * [B19001_001E], 0)) &#13;&#10;        /&#13;&#10;        SUM(IIF([B19013_001E] &gt; 0, [B19001_001E], 0))&#13;&#10;   } &lt; 40000&#13;&#10;THEN &quot;Below 40,000$&quot;&#13;&#10;&#13;&#10;ELSEIF { FIXED [NTAName] :&#13;&#10;        SUM(IIF([B19013_001E] &gt; 0, [B19013_001E] * [B19001_001E], 0)) &#13;&#10;        /&#13;&#10;        SUM(IIF([B19013_001E] &gt; 0, [B19001_001E], 0))&#13;&#10;   } &lt; 80000&#13;&#10;THEN &quot;Between 40,000$-80,000$&quot;&#13;&#10;&#13;&#10;ELSEIF { FIXED [NTAName] :&#13;&#10;        SUM(IIF([B19013_001E] &gt; 0, [B19013_001E] * [B19001_001E], 0)) &#13;&#10;        /&#13;&#10;        SUM(IIF([B19013_001E] &gt; 0, [B19001_001E], 0))&#13;&#10;   } &lt; 120000&#13;&#10;THEN &quot;Between 80,000$-120,000$&quot;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;ELSE &quot;Over 120,000$&quot;&#13;&#10;END' />
      </column>
      <column caption='Family Household Share' datatype='real' default-format='p0%' name='[Calculation_1436929814205292556]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([B11001_002E]) / SUM([B11001_001E])' />
      </column>
      <column caption='Non-Family Household Share' datatype='real' default-format='p0%' name='[Calculation_1436929814206103565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([B11001_007E]) / SUM([B11001_001E])' />
      </column>
      <column caption='&gt; High School' datatype='real' default-format='p0%' name='[Calculation_1436929814225162255]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    ([B15003_001E] - &#13;&#10;     ([B15003_016E] + [B15003_017E] + [B15003_018E] +&#13;&#10;      [B15003_021E] + [B15003_022E] + [B15003_023E] + [B15003_024E] + [B15003_025E]))&#13;&#10;) &#13;&#10;/ SUM([B15003_001E])' />
      </column>
      <column caption='High School ' datatype='real' default-format='p0%' name='[Calculation_1436929814225375248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([B15003_016E]) / SUM([B15003_001E])' />
      </column>
      <column caption='Some College' datatype='real' default-format='p0%' name='[Calculation_1436929814225559569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([B15003_017E] + [B15003_018E]) / SUM([B15003_001E])' />
      </column>
      <column caption='Bachelor’s' datatype='real' default-format='p0%' name='[Calculation_1436929814226227218]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([B15003_021E]) / SUM([B15003_001E])' />
      </column>
      <column caption='Advanced' datatype='real' default-format='p0%' name='[Calculation_1436929814226477075]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([B15003_022E] + [B15003_023E] + [B15003_024E] + [B15003_025E]) / SUM([B15003_001E])' />
      </column>
      <column caption='Male Median Earnings' datatype='real' default-format='*$#,##0,&quot;K&quot;' name='[Calculation_1436929814241619988]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([B20002_002E] &gt; 0, [B20002_002E] * [B01001_001E], 0))&#13;&#10;/&#13;&#10;SUM(IIF([B20002_002E] &gt; 0, [B01001_001E], 0))' />
      </column>
      <column caption='Female Median Earnings' datatype='real' default-format='*$#,##0,&quot;K&quot;' name='[Calculation_1436929814241812501]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([B20002_003E] &gt; 0, [B20002_003E] * [B01001_001E], 0))&#13;&#10;/&#13;&#10;SUM(IIF([B20002_003E] &gt; 0, [B01001_001E], 0))' />
      </column>
      <column caption='% Employed ' datatype='real' default-format='p0%' name='[Calculation_1436929814243065878]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( SUM([B23025_002E]) - SUM([B23025_005E]) ) / SUM([B23025_001E])' />
      </column>
      <column caption='% Unemployed' datatype='real' default-format='p0%' name='[Calculation_1436929814243205143]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([B23025_005E]) / SUM([B23025_001E])' />
      </column>
      <column caption='% Not in Labor Force' datatype='real' default-format='p0%' name='[Calculation_1436929814250577945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( SUM([B23025_001E]) - SUM([B23025_002E]) ) / SUM([B23025_001E])' />
      </column>
      <column caption='With Disability' datatype='real' default-format='p0%' name='[Calculation_1436929814253076506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([B18101_002E]) / SUM([B18101_001E])' />
      </column>
      <column caption='Without Disability' datatype='real' default-format='p0%' name='[Calculation_1436929814253285403]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([B18101_001E]) - SUM([B18101_002E])) / SUM([B18101_001E])' />
      </column>
      <column caption='Median Household Income Without Nulls' datatype='integer' name='[Calculation_480196368053219332]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [B19013_001E] = -666666666 THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    [B19013_001E]&#13;&#10;END' />
      </column>
      <column caption='Median Household Income' datatype='real' default-format='*$#,##0,&quot;K&quot;' name='[Calculation_480196368053501957]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_480196368053219332] * [B01001_001E]) /&#13;&#10;SUM(IF NOT ISNULL([Calculation_480196368053219332]) THEN [B01001_001E] ELSE 0 END)' />
      </column>
      <column caption='% of Renters Paying &gt;30% of Income for Rent' datatype='real' default-format='p0%' name='[Calculation_480196368054554630]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([B25070_007E]) +&#13;&#10; SUM([B25070_008E]) +&#13;&#10; SUM([B25070_009E]) +&#13;&#10; SUM([B25070_010E]))&#13;&#10;/ SUM([B25003_003E])' />
      </column>
      <column caption='Filter for Populated Neigbrhoods' datatype='string' name='[Calculation_480196368054988807]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [B19001_001E] &gt; 0 &#13;&#10;   AND NOT ISNULL([B19013_001E]) &#13;&#10;   AND [B19013_001E] &gt; 0&#13;&#10;THEN &quot;Valid&quot;&#13;&#10;ELSE &quot;Exclude&quot;&#13;&#10;END' />
      </column>
      <column caption='% of Population Iiving Below The Povery Line' datatype='real' default-format='p0%' name='[Calculation_897623758525497344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([B17001_002E]) / SUM([B17001_001E])' />
      </column>
      <column caption='% of Population Iiving Over The Povery Line' datatype='real' default-format='p0%' name='[Calculation_897623758525804545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([B17001_001E]) - SUM([B17001_002E])) / SUM([B17001_001E])' />
      </column>
      <column caption='Neigborhoods by Dominant Race Group' datatype='string' name='[Calculation_897623758541545478]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([B03002_003E]) / SUM([B03002_001E]) &gt;= 0.5 THEN &quot;White-dominant&quot;&#13;&#10;ELSEIF SUM([B03002_004E]) / SUM([B03002_001E]) &gt;= 0.5 THEN &quot;Black-dominant&quot;&#13;&#10;ELSEIF SUM([B03002_006E]) / SUM([B03002_001E]) &gt;= 0.5 THEN &quot;Asian-dominant&quot;&#13;&#10;ELSEIF SUM([B03002_012E]) / SUM([B03002_001E]) &gt;= 0.5 THEN &quot;Hispanic-dominant&quot;&#13;&#10;&#13;&#10;ELSEIF SUM([B03002_003E]) / SUM([B03002_001E]) &gt;= 0.4&#13;&#10;   AND SUM([B03002_003E]) / SUM([B03002_001E]) &gt;= SUM([B03002_004E]) / SUM([B03002_001E])&#13;&#10;   AND SUM([B03002_003E]) / SUM([B03002_001E]) &gt;= SUM([B03002_006E]) / SUM([B03002_001E])&#13;&#10;   AND SUM([B03002_003E]) / SUM([B03002_001E]) &gt;= SUM([B03002_012E]) / SUM([B03002_001E])&#13;&#10;THEN &quot;Plurality White&quot;&#13;&#10;&#13;&#10;ELSEIF SUM([B03002_004E]) / SUM([B03002_001E]) &gt;= 0.4&#13;&#10;   AND SUM([B03002_004E]) / SUM([B03002_001E]) &gt;= SUM([B03002_003E]) / SUM([B03002_001E])&#13;&#10;   AND SUM([B03002_004E]) / SUM([B03002_001E]) &gt;= SUM([B03002_006E]) / SUM([B03002_001E])&#13;&#10;   AND SUM([B03002_004E]) / SUM([B03002_001E]) &gt;= SUM([B03002_012E]) / SUM([B03002_001E])&#13;&#10;THEN &quot;Plurality Black&quot;&#13;&#10;&#13;&#10;ELSEIF SUM([B03002_006E]) / SUM([B03002_001E]) &gt;= 0.4&#13;&#10;   AND SUM([B03002_006E]) / SUM([B03002_001E]) &gt;= SUM([B03002_003E]) / SUM([B03002_001E])&#13;&#10;   AND SUM([B03002_006E]) / SUM([B03002_001E]) &gt;= SUM([B03002_004E]) / SUM([B03002_001E])&#13;&#10;   AND SUM([B03002_006E]) / SUM([B03002_001E]) &gt;= SUM([B03002_012E]) / SUM([B03002_001E])&#13;&#10;THEN &quot;Plurality Asian&quot;&#13;&#10;&#13;&#10;ELSEIF SUM([B03002_012E]) / SUM([B03002_001E]) &gt;= 0.4&#13;&#10;   AND SUM([B03002_012E]) / SUM([B03002_001E]) &gt;= SUM([B03002_003E]) / SUM([B03002_001E])&#13;&#10;   AND SUM([B03002_012E]) / SUM([B03002_001E]) &gt;= SUM([B03002_004E]) / SUM([B03002_001E])&#13;&#10;   AND SUM([B03002_012E]) / SUM([B03002_001E]) &gt;= SUM([B03002_006E]) / SUM([B03002_001E])&#13;&#10;THEN &quot;Plurality Hispanic&quot;&#13;&#10;&#13;&#10;ELSE &quot;Mixed&quot;&#13;&#10;END' />
      </column>
      <column caption='Neigborhood Racial Majority Group' datatype='string' name='[Calculation_897623758544334855]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [NTAName] :&#13;&#10;    IF SUM([B03002_003E]) / SUM([B03002_001E]) &gt;= 0.5 THEN &quot;Majority White&quot;&#13;&#10;    ELSEIF SUM([B03002_004E]) / SUM([B03002_001E]) &gt;= 0.5 THEN &quot;Majority Black&quot;&#13;&#10;    ELSEIF SUM([B03002_006E]) / SUM([B03002_001E]) &gt;= 0.5 THEN &quot;Majority Asian&quot;&#13;&#10;    ELSEIF SUM([B03002_012E]) / SUM([B03002_001E]) &gt;= 0.5 THEN &quot;Majority Hispanic&quot;&#13;&#10;&#13;&#10;    ELSEIF SUM([B03002_003E]) / SUM([B03002_001E]) &gt;= 0.4&#13;&#10;       AND SUM([B03002_003E]) / SUM([B03002_001E]) &gt;= SUM([B03002_004E]) / SUM([B03002_001E])&#13;&#10;       AND SUM([B03002_003E]) / SUM([B03002_001E]) &gt;= SUM([B03002_006E]) / SUM([B03002_001E])&#13;&#10;       AND SUM([B03002_003E]) / SUM([B03002_001E]) &gt;= SUM([B03002_012E]) / SUM([B03002_001E])&#13;&#10;    THEN &quot;Plurality White&quot;&#13;&#10;&#13;&#10;    ELSEIF SUM([B03002_004E]) / SUM([B03002_001E]) &gt;= 0.4&#13;&#10;       AND SUM([B03002_004E]) / SUM([B03002_001E]) &gt;= SUM([B03002_003E]) / SUM([B03002_001E])&#13;&#10;       AND SUM([B03002_004E]) / SUM([B03002_001E]) &gt;= SUM([B03002_006E]) / SUM([B03002_001E])&#13;&#10;       AND SUM([B03002_004E]) / SUM([B03002_001E]) &gt;= SUM([B03002_012E]) / SUM([B03002_001E])&#13;&#10;    THEN &quot;Plurality Black&quot;&#13;&#10;&#13;&#10;    ELSEIF SUM([B03002_006E]) / SUM([B03002_001E]) &gt;= 0.4&#13;&#10;       AND SUM([B03002_006E]) / SUM([B03002_001E]) &gt;= SUM([B03002_003E]) / SUM([B03002_001E])&#13;&#10;       AND SUM([B03002_006E]) / SUM([B03002_001E]) &gt;= SUM([B03002_004E]) / SUM([B03002_001E])&#13;&#10;       AND SUM([B03002_006E]) / SUM([B03002_001E]) &gt;= SUM([B03002_012E]) / SUM([B03002_001E])&#13;&#10;    THEN &quot;Plurality Asian&quot;&#13;&#10;&#13;&#10;    ELSEIF SUM([B03002_012E]) / SUM([B03002_001E]) &gt;= 0.4&#13;&#10;       AND SUM([B03002_012E]) / SUM([B03002_001E]) &gt;= SUM([B03002_003E]) / SUM([B03002_001E])&#13;&#10;       AND SUM([B03002_012E]) / SUM([B03002_001E]) &gt;= SUM([B03002_004E]) / SUM([B03002_001E])&#13;&#10;       AND SUM([B03002_012E]) / SUM([B03002_001E]) &gt;= SUM([B03002_006E]) / SUM([B03002_001E])&#13;&#10;    THEN &quot;Plurality Hispanic&quot;&#13;&#10;&#13;&#10;    ELSE &quot;Mixed&quot;&#13;&#10;    END&#13;&#10;}' />
      </column>
      <column caption='Median Household Income (NTA FIXED)' datatype='real' default-format='C1033%' name='[Calculation_897623758544556040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [NTAName] :&#13;&#10;    SUM([Calculation_480196368053219332] * [B19001_001E])&#13;&#10;    / SUM([B19001_001E])&#13;&#10;}' />
      </column>
