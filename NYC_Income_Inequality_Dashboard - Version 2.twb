            </column>
            <column caption='Povery level Tooltip' datatype='string' name='[Calculation_1371064671698857987]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_480196368053501957]) OR [Calculation_480196368053501957] &lt;= 0 THEN&#13;&#10;    &quot;Not Applicable (Non Populated Area)&quot;&#13;&#10;ELSE&#13;&#10;    STR(ROUND([Calculation_897623758525497344] * 100, 0)) + &quot;%&quot;&#13;&#10;END' />
            </column>
            <column caption='Median Household Income Without Nulls' datatype='integer' name='[Calculation_480196368053219332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [B19013_001E] = -666666666 THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    [B19013_001E]&#13;&#10;END' />
            </column>
            <column caption='Median Household Income' datatype='real' default-format='*$#,##0,&quot;K&quot;' name='[Calculation_480196368053501957]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_480196368053219332] * [B01001_001E]) /&#13;&#10;SUM(IF NOT ISNULL([Calculation_480196368053219332]) THEN [B01001_001E] ELSE 0 END)' />
            </column>
            <column caption='% of Renters Paying &gt;30% of Income for Rent' datatype='real' default-format='p0%' name='[Calculation_480196368054554630]' role='measure' type='quantitative'>
