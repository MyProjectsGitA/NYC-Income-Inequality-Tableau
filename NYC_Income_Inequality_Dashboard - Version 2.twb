      <table>
        <view>
          <datasources>
            <datasource caption='nynta2020.shp+ (Multiple Connections)' name='federated.0fqqhae0jzv21w145ovdf1shrfhm' />
          </datasources>
          <datasource-dependencies datasource='federated.0fqqhae0jzv21w145ovdf1shrfhm'>
            <column caption='B03002 001E' datatype='integer' name='[B03002_001E]' role='measure' type='quantitative' />
            <column caption='B03002 003E' datatype='integer' name='[B03002_003E]' role='measure' type='quantitative' />
