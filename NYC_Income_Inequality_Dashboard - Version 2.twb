            <column caption='Borough Name' datatype='string' name='[BoroName]' role='dimension' type='nominal' />
            <column caption='% Employed ' datatype='real' default-format='p0%' name='[Calculation_1436929814243065878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( SUM([B23025_002E]) - SUM([B23025_005E]) ) / SUM([B23025_001E])' />
